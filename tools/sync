"""Keep the files every phosphor-works repository shares the same everywhere.

  tools/sync                 write the shared files into every sibling repository
  tools/sync --check         report every file that differs, and exit 1 if any does
  tools/sync --repo NAME     only that repository (repeatable)
  tools/sync --check --repo NAME --documents KIND
                             also check the documents of NAME, a README of
                             shape KIND, when "documents" does not list it

sync/repos.json says what goes where:
- "files": files copied as they are (.clang-format, .editorconfig).
- "presets": the repositories that get the shared CMakePresets.json, each with
  the cache variables of its own that every preset sets (PlasmaZones'
  BUILD_TOOLS). The presets are dev (Debug, into build/), release,
  relwithdebinfo and asan (ASan and UBSan at -O1), with a build, test and
  workflow preset for each.
- "lefthook": the repositories whose lefthook.yml must pull the shared hooks
  (lefthook/common.yml) through `remotes:`. A repository without one gets a
  lefthook.yml that only does that. One with commands of its own is checked,
  not rewritten.
- "claude": the repositories whose CLAUDE.md starts with the shared block
  (sync/claude-header.md, between its BEGIN and END markers, after the SPDX
  lines) and then has only the standard sections, in their order (SECTIONS).
  tools/sync writes the block. The sections are each repository's own, and
  --check reports a missing, unknown or misplaced one.
- Pins: a repository that pins a library (an archive of a phosphor-works
  repository at a commit, in cmake/*Dependencies.cmake) that pins a third
  repository too must pin the same commit of that one: the first pin wins in
  the build, and the library was tested with its own. --check reads the
  library's pins at the pinned commit from its sibling checkout.
- Recipes: each archive that a recipe of a repository names (flake.nix, the
  Nix, Arch, RPM, Debian and OBS recipes) must be one that a pin names: a pin
  of the repository, or of a phosphor-works repository that it pins, at the
  pinned commit, and so on. A Nix entry's hash must be the SHA-256 of its pin.
  A recipe in the packaging repository belongs to the app that its top
  directory names (plasmazones/ is PlasmaZones), and is checked against the
  pins of that app's checkout.
- "documents": the repositories whose READMEs and docs/ pages --check holds
  to the shapes of "Documents" in claude/conventions.md, each with the shape
  of its own README.md ("app", "collection" or "other").
- "ref": the tag of this repository that every repository uses the shared
  CI workflows (`phosphor-works/workspace/.github/workflows/<name>.yml@<ref>`)
  and the shared hooks (the `ref:` of the lefthook remote) at. tools/sync
  writes it into each workflow and lefthook.yml.

Change a shared file here, run tools/sync, and commit the result in each
repository. A repository never edits these files itself.
"""

import argparse
import base64
import json
import re
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent.parent
ROOT = HERE.parent
MANIFEST = json.loads((HERE / 'sync/repos.json').read_text())

REMOTE_URL = 'https://github.com/phosphor-works/workspace'
REMOTE_CONFIG = 'lefthook/common.yml'
REF = MANIFEST['ref']
CLAUDE_HEADER = HERE / 'sync' / 'claude-header.md'
CLAUDE_BEGIN = '<!-- BEGIN shared:'
CLAUDE_END = '<!-- END shared -->'
# The sections of a CLAUDE.md after the shared block, in this order. The
# required ones come in every repository.
SECTIONS = ['Overview', 'Layout', 'Build and test', 'Rules', 'Code', 'Skills and agents', 'Other repositories',
            'Where things are']
REQUIRED_SECTIONS = ['Overview', 'Layout', 'Build and test']
# The shapes of "Documents" in claude/conventions.md: the ## sections of each
# kind of page, in order. A name in brackets is optional, and TOPIC is a place
# for any number of sections of the page's own.
TOPIC = '*'
DOCUMENT_SHAPES = {
    'app': ['Features', 'Install', 'Build', '[Documentation]', 'Contributing', 'License'],
    'collection': ['Libraries', 'Build', 'Use from an app', 'Contributing', 'License'],
    'library': ['Responsibility', 'Key types', 'Use', TOPIC, '[Design notes]', 'Dependencies', '[See also]'],
    'other': ['[Contents]', '[Use]', TOPIC, '[Contributing]', '[License]'],
    'index': ['Pages'],
    'page': [TOPIC, '[Limits]', '[Troubleshooting]', '[See also]'],
}
# Markdown files that are not documents of the repository: tooling, licenses,
# generated or published content.
DOCUMENT_SKIP = re.compile(r'^(\.claude|\.github|LICENSES|templates|plugins|src/content|node_modules)/'
                           r'|(^|/)(CLAUDE|CHANGELOG|CHANGES|CONTRIBUTING|SKILL)\.md$')
WORKFLOW_USE = re.compile(r'(phosphor-works/workspace/\.github/workflows/[\w.-]+\.ya?ml)@([\w./-]+)')
REMOTE_REF = re.compile(r'(git_url: ' + re.escape(REMOTE_URL) + r'\n\s+ref: )(\S+)')
LEFTHOOK_MINIMAL = f"""# SPDX-FileCopyrightText: 2026 Phosphor Works Team
# SPDX-License-Identifier: CC0-1.0
#
# Git hooks (https://github.com/evilmartians/lefthook). The shared ones (clang-format,
# qmlformat, the Conventional Commits check) come from the workspace repository.
# `lefthook install` sets them up, and workspace/tools/setup runs it.
remotes:
  - git_url: {REMOTE_URL}
    ref: {REF}
    configs:
      - {REMOTE_CONFIG}
"""


def all_repos():
    names = [line.split(':')[0].strip() for line in (HERE / 'workspace.repos').read_text().splitlines()
             if line.startswith('  ') and not line.startswith('   ') and line.strip().endswith(':')]
    return names + ['workspace']


def repos_of(spec):
    return all_repos() if spec == 'all' else list(spec)


def repo_dir(name):
    return HERE if name == 'workspace' else ROOT / name


def presets(extra):
    """The shared CMakePresets.json, with EXTRA cache variables in every preset."""
    base_vars = {'BUILD_TESTING': 'ON', 'CMAKE_EXPORT_COMPILE_COMMANDS': 'ON', **extra}
    sanitize = '-O1 -fsanitize=address,undefined -fno-omit-frame-pointer -Wno-maybe-uninitialized'
    configs = [
        {'name': 'base', 'hidden': True, 'generator': 'Ninja', 'binaryDir': '${sourceDir}/build-${presetName}',
         'cacheVariables': base_vars},
        {'name': 'dev', 'displayName': 'Debug, with tests', 'inherits': 'base', 'binaryDir': '${sourceDir}/build',
         'cacheVariables': {'CMAKE_BUILD_TYPE': 'Debug'}},
        {'name': 'release', 'displayName': 'Release, with tests', 'inherits': 'base',
         'cacheVariables': {'CMAKE_BUILD_TYPE': 'Release'}},
        {'name': 'relwithdebinfo', 'displayName': 'RelWithDebInfo, with tests', 'inherits': 'base',
         'cacheVariables': {'CMAKE_BUILD_TYPE': 'RelWithDebInfo'}},
        {'name': 'asan', 'displayName': 'ASan and UBSan at -O1, with tests', 'inherits': 'base',
         'cacheVariables': {'CMAKE_BUILD_TYPE': 'Debug', 'CMAKE_C_FLAGS': sanitize, 'CMAKE_CXX_FLAGS': sanitize}},
    ]
    names = ['dev', 'release', 'relwithdebinfo', 'asan']
    data = {
        'version': 6,
        'cmakeMinimumRequired': {'major': 3, 'minor': 25, 'patch': 0},
        'configurePresets': configs,
        # 3 jobs, so a build stays inside the memory cap of the conventions.
        # Without it Ninja runs a job for each CPU.
        'buildPresets': [{'name': 'base', 'hidden': True, 'jobs': 3}]
                        + [{'name': n, 'inherits': 'base', 'configurePreset': n} for n in names],
        'testPresets': [{'name': 'base', 'hidden': True, 'output': {'outputOnFailure': True},
                         'execution': {'noTestsAction': 'error', 'jobs': 3}}]
                       + [{'name': n, 'inherits': 'base', 'configurePreset': n} for n in names],
        'workflowPresets': [{'name': n, 'steps': [{'type': t, 'name': n} for t in ('configure', 'build', 'test')]}
                            for n in names],
    }
    return json.dumps(data, indent=4) + '\n'


def expected_files(repo):
    """{relative path: content} of the files this repository must hold exactly."""
    out = {}
    for entry in MANIFEST['files']:
        if repo in repos_of(entry['repos']):
            out[entry['path']] = (HERE / entry['source']).read_text()
    if repo in MANIFEST['presets']:
        out['CMakePresets.json'] = presets(MANIFEST['presets'][repo])
    return out


def pin_refs(root):
    """{relative path: content with every shared-workflow and hook ref set to REF} for the files that differ."""
    out = {}
    paths = sorted((root / '.github/workflows').glob('*.y*ml')) + [root / 'lefthook.yml']
    for path in paths:
        if not path.is_file():
            continue
        text = path.read_text()
        pinned = REMOTE_REF.sub(lambda m: m.group(1) + REF, WORKFLOW_USE.sub(lambda m: f'{m.group(1)}@{REF}', text))
        if pinned != text:
            out[str(path.relative_to(root))] = pinned
    return out


def claude_block(repo):
    conventions = 'claude/conventions.md' if repo == 'workspace' else '../workspace/claude/conventions.md'
    return CLAUDE_HEADER.read_text().replace('@REPO@', repo).replace('@CONVENTIONS@', conventions)


def claude_md(repo, root):
    """(the CLAUDE.md with the shared block as it must be, or None when it is so already, [problems])."""
    path = root / 'CLAUDE.md'
    if not path.exists():
        return None, ['missing']
    text = path.read_text()
    lines = text.splitlines(keepends=True)
    begin = next((i for i, line in enumerate(lines) if line.startswith(CLAUDE_BEGIN)), None)
    end = next((i for i, line in enumerate(lines) if line.startswith(CLAUDE_END)), None)
    if begin is None or end is None or end < begin:
        return None, ['has no shared block (the BEGIN shared and END shared markers of sync/claude-header.md)']
    problems = []
    if any(line.strip() and not line.startswith('<!-- SPDX-') for line in lines[:begin]):
        problems.append('has text before the shared block other than the SPDX lines')
    headings, fence = [], False
    for line in lines[end + 1:]:
        if line.startswith('```'):
            fence = not fence
        elif not fence and line.startswith('# '):
            problems.append(f'has a second title: {line.strip()}')
        elif not fence and line.startswith('## '):
            headings.append(line[3:].strip())
    unknown = [h for h in headings if h not in SECTIONS]
    if unknown:
        problems.append('has sections that are not standard: ' + ', '.join(unknown) + ' (SECTIONS in tools/sync)')
    known = [SECTIONS.index(h) for h in headings if h in SECTIONS]
    if known != sorted(set(known)) or len(known) != len(set(known)):
        problems.append('has its sections out of order or twice: ' + ', '.join(headings))
    missing = [h for h in REQUIRED_SECTIONS if h not in headings]
    if missing:
        problems.append('misses the sections ' + ', '.join(missing))
    want = ''.join(lines[:begin]) + claude_block(repo) + ''.join(lines[end + 1:])
    return (want if want != text else None), problems


PIN = re.compile(r'^set\(\w+_DEP_([\w.-]+)_VERSION "([0-9a-f]{40})"\)', re.M)


def pins_of(text):
    """{repository: commit} of the commit pins in a *Dependencies.cmake text."""
    return dict(PIN.findall(text))


ARCHIVE_PIN = re.compile(r'set\(\w+_DEP_([\w.-]+)_(VERSION|FILE|SHA256) "([^"]+)"\)')
RECIPE = re.compile(r'(^|/)(flake\.nix|nix/[^/]+\.nix|PKGBUILD[^/]*|[^/]+\.spec|debian/[^/]+|obs/[^/]+)$')
ARCHIVE = re.compile(r'[A-Za-z][\w.+-]*?-(?:[0-9a-f]{40}|v?\d[\w.]*?)\.tar\.gz')
NIX_ENTRY = re.compile(r'name = "([^"]+\.tar\.gz)";(.*?)hash = "(sha256-[^"]+)"', re.S)


def sri(sha256):
    """The Nix SRI form of a hex SHA-256."""
    return 'sha256-' + base64.b64encode(bytes.fromhex(sha256)).decode()


def archive_pins(repo, rev=None):
    """{name: {VERSION, FILE, SHA256}} of the pin file of @p repo, in its checkout or at commit @p rev. None when
    the checkout does not have @p rev."""
    root = repo_dir(repo)
    listing = subprocess.run(['git', '-C', str(root), 'ls-tree', '--name-only', rev or 'HEAD', 'cmake/'],
                             capture_output=True, text=True)
    if listing.returncode != 0:
        return None
    listed = listing.stdout.split()
    names = [n for n in listed if n.endswith('Dependencies.cmake')]
    if not names:
        return {}
    if rev is None:
        text = (root / names[0]).read_text()
    else:
        text = subprocess.run(['git', '-C', str(root), 'show', f'{rev}:{names[0]}'], capture_output=True,
                              text=True).stdout
    out = {}
    for name, key, value in ARCHIVE_PIN.findall(text):
        out.setdefault(name, {})[key] = value
    return out


def pinned_archives(repo):
    """{file name: sha256} of each archive that a pin names: of @p repo, and of each phosphor-works repository it
    pins, at the pinned commit, and so on. None when a checkout does not have a pinned commit: pin_problems
    reports that."""
    out, seen, todo = {}, set(), [(repo, None)]
    while todo:
        name, rev = todo.pop()
        if (name, rev) in seen:
            continue
        seen.add((name, rev))
        pins = archive_pins(name, rev)
        if pins is None:
            return None
        for dep, pin in pins.items():
            if 'FILE' in pin and 'SHA256' in pin:
                out[pin['FILE']] = pin['SHA256']
            if dep in all_repos() and (repo_dir(dep) / '.git').exists() and \
                    re.fullmatch(r'[0-9a-f]{40}', pin.get('VERSION', '')):
                todo.append((dep, pin['VERSION']))
    return out


PACKAGING = 'packaging'


def recipe_owner(repo, rel):
    """The repository whose pins the recipe @p rel of @p repo must match: @p repo itself, or for a recipe of the
    packaging repository, the repository that its top directory names, in any case. None when no repository has
    that name."""
    if repo != PACKAGING:
        return repo
    top = rel.split('/', 1)[0].lower()
    return next((name for name in all_repos() if name.lower() == top and name != PACKAGING), None)


def recipe_problems(repo, root):
    """Each archive that a recipe of @p repo names and no pin names, and each Nix hash that differs from its pin."""
    files = [f for f in subprocess.run(['git', '-C', str(root), 'ls-files'], capture_output=True,
                                       text=True).stdout.split() if RECIPE.search(f)]
    problems = []
    pinned_of = {}
    for rel in files:
        owner = recipe_owner(repo, rel)
        if owner is None:
            problems.append(f'{rel}: is a recipe of no repository, because its top directory names none in workspace.repos')
            continue
        if owner not in pinned_of:
            if owner != repo and not (repo_dir(owner) / '.git').exists():
                problems.append(f'{rel}: is a recipe of {owner}, which is not cloned, so its pins were not read')
                pinned_of[owner] = None
                continue
            pinned_of[owner] = pinned_archives(owner)
        pinned = pinned_of[owner]
        # None: a checkout lacks a pinned commit, which pin_problems reports.
        if pinned is None:
            continue
        text = (root / rel).read_text(errors='replace')
        for name in sorted(set(ARCHIVE.findall(text))):
            if name not in pinned:
                problems.append(f'{rel}: bundles {name}, which no pin of {owner} or of a library it pins names')
        for name, _, nix_hash in NIX_ENTRY.findall(text):
            if name in pinned and nix_hash != sri(pinned[name]):
                problems.append(f'{rel}: the hash of {name} is not the SHA-256 of its pin')
    return problems


def pin_problems(repo, root):
    """Each pin of @p repo that differs from the pin of the same repository in a library it pins."""
    files = sorted((root / 'cmake').glob('*Dependencies.cmake'))
    if not files:
        return []
    own = pins_of(files[0].read_text())
    problems = []
    for lib, commit in own.items():
        lib_root = repo_dir(lib) if lib in all_repos() else None
        if lib_root is None or not (lib_root / '.git').exists():
            continue
        listed = subprocess.run(['git', '-C', str(lib_root), 'ls-tree', '--name-only', commit, 'cmake/'],
                                capture_output=True, text=True)
        names = [n for n in listed.stdout.split() if n.endswith('Dependencies.cmake')]
        if listed.returncode != 0:
            problems.append(f'pins {lib} at {commit[:8]}, which its checkout does not have: fetch it')
            continue
        if not names:
            continue
        shown = subprocess.run(['git', '-C', str(lib_root), 'show', f'{commit}:{names[0]}'], capture_output=True,
                               text=True)
        for dep, theirs in pins_of(shown.stdout).items():
            mine = own.get(dep)
            if mine and mine != theirs:
                problems.append(f'pins {dep} at {mine[:8]}, but the {lib} it pins ({commit[:8]}) pins {theirs[:8]}')
    return problems


def document_kind(rel, readme_kind):
    """The shape of the page at REL, or None when it is not a document."""
    if DOCUMENT_SKIP.search(rel):
        return None
    if rel == 'README.md':
        return readme_kind
    if rel.startswith('docs/'):
        return 'index' if rel.endswith('/README.md') else 'page'
    if re.fullmatch(r'libs/[^/]+/README\.md', rel):
        return 'library'
    if rel.endswith('README.md'):
        return 'other'
    return None


def shape_problems(headings, shape):
    """Why the ## HEADINGS do not follow SHAPE, as a list."""
    names = [s.strip('[]') for s in shape]
    required = [s for s in shape if s != TOPIC and not s.startswith('[')]
    problems, at = [], 0  # at: the index in SHAPE that the last heading took
    for h in headings:
        if h in names[at:]:
            at = names.index(h, at)
            continue
        topic = shape.index(TOPIC) if TOPIC in shape else -1
        if topic >= at:
            at = topic
            continue
        if h in names:
            problems.append(f'has "{h}" out of order or twice')
        else:
            problems.append(f'has a section "{h}" that its shape has no place for')
    missing = [h for h in required if h not in headings]
    if missing:
        problems.append('misses the sections ' + ', '.join(f'"{h}"' for h in missing))
    return problems


def document_problems(root, readme_kind):
    """{path: [problems]} of the READMEs and docs/ pages of the repository at ROOT."""
    files = subprocess.run(['git', '-C', str(root), 'ls-files', '--cached', '--others', '--exclude-standard', '*.md'],
                           capture_output=True, text=True, check=True).stdout.split()
    out = {}
    for rel in files:
        kind = document_kind(rel, readme_kind)
        if kind is None:
            continue
        lines = (root / rel).read_text().splitlines()
        problems = []
        body = [line for line in lines if not line.startswith('<!-- SPDX-')]
        if not any(line.startswith('<!-- SPDX-License-Identifier:') for line in lines[:3]):
            problems.append('does not start with the SPDX lines')
        text = [line for line in body if line.strip()]
        if not text or not text[0].startswith('# '):
            problems.append('does not start with a # title')
        elif len(text) < 2 or text[1].startswith('#'):
            problems.append('has no paragraph under its title')
        headings, fence = [], False
        for line in body:
            if line.startswith('```') or line.startswith('~~~'):
                fence = not fence
            elif not fence and line.startswith('## '):
                headings.append(line[3:].strip())
            elif not fence and line.startswith('# ') and text and line != text[0]:
                problems.append(f'has a second title: {line.strip()}')
        problems += shape_problems(headings, DOCUMENT_SHAPES[kind])
        if problems:
            out[f'{rel} ({kind})'] = problems
    return out


def lefthook_problem(path):
    """Why PATH does not pull the shared hooks, or None."""
    if not path.exists():
        return 'missing'
    text = path.read_text()
    if REMOTE_URL not in text or REMOTE_CONFIG not in text:
        return f'does not pull {REMOTE_CONFIG} from {REMOTE_URL} through remotes:'
    return None


def main():
    parser = argparse.ArgumentParser(description=__doc__.split('\n\n')[0])
    parser.add_argument('--check', action='store_true', help='report differences, change nothing')
    parser.add_argument('--repo', action='append', help='only this repository')
    parser.add_argument('--documents', choices=['app', 'collection', 'other'],
                        help='check the documents of each --repo with this README shape, listed or not')
    args = parser.parse_args()
    repos = args.repo or all_repos()
    unknown = set(repos) - set(all_repos())
    if unknown:
        parser.error(f'not in workspace.repos: {", ".join(sorted(unknown))}')

    problems, written = [], []
    for repo in repos:
        root = repo_dir(repo)
        if not (root / '.git').exists():
            print(f'{repo}: not cloned, skipped', file=sys.stderr)
            continue
        for rel, content in expected_files(repo).items():
            path = root / rel
            if path.exists() and path.read_text() == content:
                continue
            if args.check:
                problems.append(f'{repo}/{rel}: ' + ('missing' if not path.exists() else 'differs from the shared copy'))
            else:
                path.write_text(content)
                written.append(f'{repo}/{rel}')
        if repo in repos_of(MANIFEST['lefthook']):
            hook = root / 'lefthook.yml'
            problem = lefthook_problem(hook)
            if problem == 'missing' and not args.check:
                hook.write_text(LEFTHOOK_MINIMAL)
                written.append(f'{repo}/lefthook.yml')
            elif problem:
                problems.append(f'{repo}/lefthook.yml: {problem}')
        if repo in repos_of(MANIFEST.get('claude', [])):
            want, claude_problems = claude_md(repo, root)
            problems += [f'{repo}/CLAUDE.md: {p}' for p in claude_problems]
            if want is not None:
                if args.check:
                    problems.append(f'{repo}/CLAUDE.md: its shared block differs from sync/claude-header.md')
                else:
                    (root / 'CLAUDE.md').write_text(want)
                    written.append(f'{repo}/CLAUDE.md')
        problems += [f'{repo}/cmake: {p}' for p in pin_problems(repo, root)]
        problems += [f'{repo}/{p}' for p in recipe_problems(repo, root)]
        readme_kind = args.documents or MANIFEST.get('documents', {}).get(repo)
        if readme_kind:
            for rel, doc_problems in document_problems(root, readme_kind).items():
                problems += [f'{repo}/{rel}: {p}' for p in doc_problems]
        for rel, content in pin_refs(root).items():
            if args.check:
                problems.append(f'{repo}/{rel}: uses the shared workflows or hooks at a ref other than {REF}')
            else:
                (root / rel).write_text(content)
                written.append(f'{repo}/{rel}')

    for w in written:
        print(f'wrote {w}')
    for p in problems:
        print(p)
    if problems:
        print(f'{len(problems)} problem(s). ' + ('Run tools/sync to fix the copies, and fix the rest by hand.' if args.check
                                                    else 'Fix these by hand.'))
        return 1
    if args.check:
        print(f'{len(repos)} repositories match the shared files.')
    return 0


if __name__ == '__main__':
    sys.exit(main())
