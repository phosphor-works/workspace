{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "sanitizers",
            "hidden": true,
            "description": "ASan and UBSan at -O1. GCC's maybe-uninitialized check misfires on instrumented code.",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_FLAGS": "-O1 -fsanitize=address,undefined -fno-omit-frame-pointer -Wno-maybe-uninitialized",
                "CMAKE_CXX_FLAGS": "-O1 -fsanitize=address,undefined -fno-omit-frame-pointer -Wno-maybe-uninitialized"
            }
        },
        {
            "name": "dev",
            "displayName": "Everything: Debug",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "release",
            "displayName": "Everything: Release",
            "inherits": "base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        },
        {
            "name": "relwithdebinfo",
            "displayName": "Everything: RelWithDebInfo",
            "inherits": "base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
        },
        {
            "name": "asan",
            "displayName": "Everything: ASan and UBSan",
            "inherits": ["base", "sanitizers"]
        },
        {
            "name": "one-app",
            "hidden": true,
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "WORKSPACE_BUILD_PlasmaZones": "OFF",
                "WORKSPACE_BUILD_Lambent": "OFF",
                "WORKSPACE_BUILD_Afterglow": "OFF",
                "WORKSPACE_BUILD_Facet": "OFF",
                "WORKSPACE_BUILD_Phosphor": "OFF"
            }
        },
        {
            "name": "plasmazones",
            "displayName": "PlasmaZones alone, against the sibling libraries: Debug",
            "inherits": "one-app",
            "cacheVariables": { "WORKSPACE_BUILD_PlasmaZones": "ON" }
        },
        {
            "name": "plasmazones-asan",
            "displayName": "PlasmaZones alone: ASan and UBSan",
            "inherits": ["plasmazones", "sanitizers"]
        },
        {
            "name": "lambent",
            "displayName": "Lambent alone, against the sibling libraries: Debug",
            "inherits": "one-app",
            "cacheVariables": { "WORKSPACE_BUILD_Lambent": "ON" }
        },
        {
            "name": "lambent-asan",
            "displayName": "Lambent alone: ASan and UBSan",
            "inherits": ["lambent", "sanitizers"]
        },
        {
            "name": "afterglow",
            "displayName": "Afterglow alone, against the sibling phosphor-libs: Debug",
            "inherits": "one-app",
            "cacheVariables": { "WORKSPACE_BUILD_Afterglow": "ON" }
        },
        {
            "name": "afterglow-asan",
            "displayName": "Afterglow alone: ASan and UBSan",
            "inherits": ["afterglow", "sanitizers"]
        }
    ],
    "buildPresets": [
        { "name": "base", "hidden": true, "jobs": 3 },
        { "name": "dev", "inherits": "base", "configurePreset": "dev" },
        { "name": "release", "inherits": "base", "configurePreset": "release" },
        { "name": "relwithdebinfo", "inherits": "base", "configurePreset": "relwithdebinfo" },
        { "name": "asan", "inherits": "base", "configurePreset": "asan" },
        { "name": "plasmazones", "inherits": "base", "configurePreset": "plasmazones" },
        { "name": "plasmazones-asan", "inherits": "base", "configurePreset": "plasmazones-asan" },
        { "name": "lambent", "inherits": "base", "configurePreset": "lambent" },
        { "name": "lambent-asan", "inherits": "base", "configurePreset": "lambent-asan" },
        { "name": "afterglow", "inherits": "base", "configurePreset": "afterglow" },
        { "name": "afterglow-asan", "inherits": "base", "configurePreset": "afterglow-asan" }
    ],
    "workflowPresets": [
        {
            "name": "dev",
            "steps": [
                { "type": "configure", "name": "dev" },
                { "type": "build", "name": "dev" }
            ]
        },
        {
            "name": "release",
            "steps": [
                { "type": "configure", "name": "release" },
                { "type": "build", "name": "release" }
            ]
        },
        {
            "name": "asan",
            "steps": [
                { "type": "configure", "name": "asan" },
                { "type": "build", "name": "asan" }
            ]
        },
        {
            "name": "plasmazones",
            "steps": [
                { "type": "configure", "name": "plasmazones" },
                { "type": "build", "name": "plasmazones" }
            ]
        },
        {
            "name": "plasmazones-asan",
            "steps": [
                { "type": "configure", "name": "plasmazones-asan" },
                { "type": "build", "name": "plasmazones-asan" }
            ]
        },
        {
            "name": "lambent",
            "steps": [
                { "type": "configure", "name": "lambent" },
                { "type": "build", "name": "lambent" }
            ]
        },
        {
            "name": "lambent-asan",
            "steps": [
                { "type": "configure", "name": "lambent-asan" },
                { "type": "build", "name": "lambent-asan" }
            ]
        },
        {
            "name": "afterglow",
            "steps": [
                { "type": "configure", "name": "afterglow" },
                { "type": "build", "name": "afterglow" }
            ]
        },
        {
            "name": "afterglow-asan",
            "steps": [
                { "type": "configure", "name": "afterglow-asan" },
                { "type": "build", "name": "afterglow-asan" }
            ]
        }
    ]
}
